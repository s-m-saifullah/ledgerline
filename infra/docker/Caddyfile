{
  auto_https off
  admin off
  # The host proxy in front of this container reaches it from a private Docker address and writes the real
  # client into X-Forwarded-For. Trust private peers only, and read the chain from the right, so a client cannot
  # name itself by sending a header of its own.
  servers {
    trusted_proxies static private_ranges
    trusted_proxies_strict
  }
}
:80 {
  root * /srv
  encode zstd gzip
  header {
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
  # The API limits sign-ins per client, and reads the address from a single-address X-Forwarded-For, so the
  # header is replaced by the one client address worked out above. Without it every client looks like the host proxy.
  handle /api/* {
    reverse_proxy api:3001 {
      header_up X-Forwarded-For {client_ip}
    }
  }
  # The worker is never cached, and a missing one is a real 404 (not the app page), so a bad release cannot pin it.
  handle /sw.js {
    root * /srv
    header Cache-Control "no-store"
    file_server
  }
  # Hashed build files never change under their name, so they are kept for a year. A file that is not there is a
  # plain 404 that is never cached (not the app page, and not a year-long copy of an error), so a stale page asking
  # for a file a newer release removed gets an error it can handle.
  @assetFile {
    path /assets/*
    file {path}
  }
  handle @assetFile {
    header Cache-Control "public, max-age=31536000, immutable"
    file_server
  }
  handle /assets/* {
    header Cache-Control "no-store"
    respond 404
  }
  handle {
    root * /srv
    try_files {path} /index.html
    # The app page is served for every route, so everything except the hashed /assets files is never cached.
    @notAssets not path /assets/*
    header @notAssets Cache-Control "no-store"
    file_server
  }
}
