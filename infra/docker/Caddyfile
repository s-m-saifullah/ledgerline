{
  auto_https off
  admin off
}
:80 {
  encode zstd gzip
  header {
    Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self'; frame-ancestors 'none'; base-uri 'self'; form-action 'self'"
    X-Content-Type-Options nosniff
    Referrer-Policy no-referrer
    Permissions-Policy "camera=(), microphone=(), geolocation=()"
    -Server
  }
  handle /api/* {
    reverse_proxy api:3001
  }
  # The worker is never cached, and a missing one is a real 404 (not the app page), so a bad release cannot pin it.
  handle /sw.js {
    root * /srv
    header Cache-Control "no-store"
    file_server
  }
  handle {
    root * /srv
    try_files {path} /index.html
    # The app page is served for every route, so everything except the hashed /assets files is never cached.
    @notAssets not path /assets/*
    header @notAssets Cache-Control "no-store"
    file_server
  }
}
