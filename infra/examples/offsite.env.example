# Off-site backup settings (ADR 0037). Copy to /opt/ledgerline/offsite.env on the server, owned by the
# deploy user with mode 0600. Never commit the real file. Without it, off-site upload is switched off.

# Your age PUBLIC key (starts with age1). The private key stays on your own computer, never on the server.
OFFSITE_AGE_RECIPIENT=age1replace-with-your-public-key
# The bucket's S3 endpoint and region (shown on the bucket page), the bucket name and an optional folder.
OFFSITE_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
OFFSITE_S3_REGION=us-west-004
OFFSITE_BUCKET=your-backup-bucket
OFFSITE_PREFIX=ledgerline/
# A WRITE-ONLY application key limited to that bucket (upload only: no list, read or delete).
OFFSITE_KEY_ID=replace-with-the-key-id
OFFSITE_APP_KEY=replace-with-the-application-key
