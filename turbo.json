{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "TEST_DATABASE_URL",
    "APP_URL",
    "BETTER_AUTH_SECRET",
    "OWNER_EMAIL",
    "OWNER_PASSWORD",
    "OWNER_NAME",
    "PORT",
    "HOST"
  ],
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"] },
    "@ledgerline/shared#build": { "outputs": [] },
    "@ledgerline/ui#build": { "outputs": [] },
    "dev": { "cache": false, "persistent": true },
    "test": { "dependsOn": ["^build"], "cache": false },
    "typecheck": { "dependsOn": ["^build"], "outputs": [] }
  }
}
