# Copy with: pnpm setup (see README). Never commit .env.
NODE_ENV=development
APP_URL=http://localhost:5173
HOST=127.0.0.1
PORT=3001
POSTGRES_USER=ledgerline
POSTGRES_PASSWORD=replace-with-a-random-password
POSTGRES_DB=ledgerline
POSTGRES_PORT=5433
DATABASE_URL=postgresql://ledgerline:replace-with-a-random-password@127.0.0.1:5433/ledgerline
# Dedicated disposable database, never point this at production.
TEST_DATABASE_URL=postgresql://ledgerline:replace-with-a-random-password@127.0.0.1:5433/ledgerline_test
BETTER_AUTH_SECRET=replace-with-at-least-32-random-characters
OWNER_EMAIL=you@example.com
OWNER_NAME=Owner
OWNER_PASSWORD=replace-with-a-unique-password-at-least-12-characters
# Production: APP_URL=https://ledgerline.example.com, HOST=0.0.0.0,
# DATABASE_URL uses db:5432; images come from your private container registry.
# The release workflow and deploy script set the image names; these are for manual runs.
API_IMAGE=ghcr.io/your-account/ledgerline-api:v0.0.1
WEB_IMAGE=ghcr.io/your-account/ledgerline-web:v0.0.1
