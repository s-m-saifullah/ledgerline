{
  "$schema": "https://biomejs.dev/schemas/2.5.15/schema.json",
  "extends": ["./packages/config/biome.json"],
  "files": {
    "includes": [
      "**",
      "!**/dist",
      "!**/node_modules",
      "!**/.turbo",
      "!**/drizzle/meta",
      "!docs/openapi.json",
      "!apps/android/**/build",
      "!apps/android/.gradle",
      "!apps/android/.kotlin",
      "!apps/android/app/schemas",
      "!pnpm-lock.yaml",
      "!playwright-report",
      "!test-results",
      "!tests/e2e/.auth"
    ]
